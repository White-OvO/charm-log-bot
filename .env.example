# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same page
CLIENT_ID=

# Optional: server ID for instant command updates during development
GUILD_ID=

# Server role names allowed to run /editcontribution, comma-separated (server owner is always allowed)
# ADMIN_ROLE_NAMES=capo,executive

# Optional: role/text name that counts as a charm use (default: shinycharm)
# TRIGGER_NAME=shinycharm

# Optional: custom SQLite path (default: data/charm-log.db)
# DB_PATH=
